%% Source for architecture.svg. After editing, regenerate with:
%%   docs/assets/render-architecture.sh
%% Keep every comment line non-empty: a bare "%%" line swallows the newline
%% and breaks the parser. The "~~~" tie edges only pin the two parallel render
%% chains to the same ranks; they draw nothing. Don't remove them without
%% re-rendering and eyeballing, or the layout snaps back to a tall zig-zag.
flowchart TD
    subgraph Sources["Session sources"]
        OC["OpenCode<br/>opencode db<br/>+ export"]
        CC["Claude Code<br/>~/.claude/projects<br/>transcripts"]
        CX["Codex<br/>~/.codex state DB<br/>or rollouts"]
    end

    subgraph Pipeline["Scan pipeline"]
        SC["ScanService<br/>discover → load<br/>→ filter"]
        RV["RepositoryResolver<br/>origin → common dir<br/>→ harness → path"]
    end

    subgraph Report["Report pipeline"]
        TR["build_grouped_transcript<br/>redacted, full context"]
        RUN["opencode run<br/>local CLI narrative"]
        RN["render_narrative"]
        EX["Extraction<br/>evidence + 300-char cap"]
        RB["RuleBasedSummarizer"]
        MR["MarkdownRenderer"]
        US["Usage stats<br/>opencode stats<br/>or session tokens"]
        RD["Redaction<br/>secret patterns"]
        WR["Atomic write<br/>0600 on POSIX"]
    end

    CL["doctor / scan / report"] --> OC
    CL --> CC
    CL --> CX
    OC --> SC
    CC --> SC
    CX --> SC
    SC --> RV
    RV -->|"default"| TR
    TR --> RUN
    RUN --> RN
    RUN -.->|"on failure"| EX
    RV -->|"--no-llm"| EX
    EX --> RB
    RB --> MR
    RN ~~~ MR
    US ~~~ RN
    US --> RN
    US --> MR
    RN --> RD
    MR --> RD
    RD --> WR