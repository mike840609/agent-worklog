%% Source for architecture.svg. After editing, regenerate with:
%%   docs/assets/render-architecture.sh
%% Laid out left-to-right with each subgraph stacked top-to-bottom, so the
%% diagram stays landscape without stretching into one long row. The invisible
%% links in Sources are what stack those three nodes: without an edge between
%% them they share a rank and mermaid places them side by side.
%% (Keep every comment line non-empty; a bare "%%" line breaks the parser.)
flowchart LR
    CLI["doctor / scan / report"]

    subgraph Sources["Session sources"]
        direction TB
        OC["OpenCode<br/>opencode db + export"]
        CC["Claude Code<br/>~/.claude/projects<br/>transcripts"]
        CX["Codex<br/>~/.codex state DB<br/>or rollouts"]
        OC ~~~ CC ~~~ CX
    end

    subgraph Pipeline["Scan pipeline"]
        direction TB
        SC["ScanService<br/>discover → load → filter"]
        RV["RepositoryResolver<br/>origin → common dir<br/>→ harness → path"]
    end

    subgraph Report["Report pipeline"]
        direction TB
        EX["Extraction<br/>evidence + 300-char cap"]
        RD["Redaction<br/>secret patterns"]
        SU["Summarizer<br/>rule-based or LLM"]
        US["Usage stats<br/>opencode stats<br/>or session tokens"]
        RE["MarkdownRenderer"]
        WR["Atomic write<br/>0600 on POSIX"]
    end

    CLI --> OC
    CLI --> CC
    CLI --> CX
    OC --> SC
    CC --> SC
    CX --> SC
    SC --> RV
    RV --> EX
    EX --> RD
    RD --> SU
    US --> RE
    SU --> RE
    RE --> WR
